+// A title can retain reference execution for individually verified bad
+// translations while other programs keep the compiled path. Keys identify
+// reachable microcode, not upload addresses which different programs reuse.
+static bool reference_program(std::uint64_t key) {
+    static const auto keys = [] {
+        std::unordered_set<std::uint64_t> result;
+        const char *value = std::getenv("PS2_VU_INTERPRET_KEYS");
+        const std::string text = value ? value : "";
+        const char *at = text.c_str();
+        while (*at) {
+            char *end = nullptr;
+            const auto value = std::strtoull(at, &end, 16);
+            if (end != at) { result.insert(value); at = end; }
+            else ++at;
+        }
+        return result;
+    }();
+    if (!keys.contains(key)) return false;
+    static std::unordered_set<std::uint64_t> reported;
+    if (reported.insert(key).second)
+        std::fprintf(stderr, "[vu] reference execution for compatibility key %016llX\n", static_cast<unsigned long long>(key));
+    return true;
+}
