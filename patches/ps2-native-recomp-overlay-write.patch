+// Bulk transfers can replace an overlay and call its common entry before a
+// rotating spot check reaches a changed word. Drop only instances whose guard
+// words were overwritten; the next lookup validates the complete module.
+void code_window_written(std::uint32_t address, std::uint32_t size) {
+    if (!size) return;
+    const std::uint32_t begin = address & (kRamSize - 1);
+    const std::uint64_t end = std::uint64_t{begin} + size;
+    std::erase_if(g_instances, [&](const Instance &i) {
+        if (!i.module->fixed_base || begin >= std::uint64_t{i.base} + i.module->size || end <= i.base) return false;
+        const auto word = std::lower_bound(i.guard_words.begin(), i.guard_words.end(), begin & ~3u);
+        return word != i.guard_words.end() && *word < end;
+    });
 }
 
