+// Opt-in approximation of PATH1's concurrent reads. Some programs issue XGKICK
+// before writing the tail of a short packet. Copying it at issue reads stale
+// vertices as A+D registers. This delays the copy in VU issue cycles; it does
+// not model the GIF's entire streaming FIFO. Pending work drains at a boundary.
+class KickPipe {
+    unsigned delay_;
+    std::uint32_t due_ = 0, address_ = 0;
+    bool pending_ = false;
+    void (*send_)(int, std::uint32_t);
+public:
+    static unsigned profile() {
+        static const unsigned delay = [] {
+            const char *v = std::getenv("PS2_VU_KICK_DELAY");
+            return v ? std::min(8u, static_cast<unsigned>(std::strtoul(v, nullptr, 10))) : 0u;
+        }();
+        return delay;
+    }
+    explicit KickPipe(unsigned delay = profile(), void (*send)(int, std::uint32_t) = vu::kick)
+        : delay_(delay), send_(send) {}
+    KickPipe(const KickPipe &) = delete;
+    KickPipe &operator=(const KickPipe &) = delete;
+    ~KickPipe() { flush(); }
+    void flush() {
+        if (!pending_) return;
+        pending_ = false;
+#if defined(__SSE2__)
+        const unsigned csr = _mm_getcsr();
+        _mm_setcsr(csr & ~0x40u);
+#endif
+        send_(1, address_);
+#if defined(__SSE2__)
+        _mm_setcsr(csr);
+#endif
+    }
+    void advance(std::uint32_t cycle) {
+        if (pending_ && static_cast<std::int32_t>(cycle - due_) >= 0) flush();
+    }
+    void issue(std::uint32_t cycle, std::uint32_t address) {
+        flush();
+        address_ = address;
+        due_ = cycle + delay_;
+        pending_ = true;
+        if (!delay_) flush();
+    }
+};
+
+}
